{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis – personal AI assistant (cloud AI + local Windows agent)",
  "workspaces": [
    "shared",
    "frontend",
    "agent"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @jarvis/frontend",
    "dev:agent": "npm run dev --workspace @jarvis/agent",
    "build": "npm run build --workspace @jarvis/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
