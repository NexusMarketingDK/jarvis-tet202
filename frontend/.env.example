# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Server-only: used to broadcast actions and read encrypted API keys
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Anthropic
ANTHROPIC_API_KEY=<anthropic-api-key>

# Optional voice providers (routes return 501 when unset)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# 32-byte hex secret for AES-256-GCM encryption of stored API keys
# Generate with: openssl rand -hex 32
JARVIS_ENCRYPTION_KEY=
